<?xml version="1.0" encoding="utf-8"?>
<component>
  <name>org.freedesktop.IBus.Vikey</name>
  <description>SmartKey - Vietnamese input with automatic English/Vietnamese switching</description>
  <exec>@CMAKE_INSTALL_FULL_LIBEXECDIR@/ibus-engine-vikey --ibus</exec>
  <version>@VIKEY_VERSION@</version>
  <author>Tony Dinh</author>
  <license>GPL-3.0</license>
  <homepage>https://github.com/tdhieu94/SmartKey</homepage>
  <textdomain>vikey</textdomain>
  <engines>
    <engine>
      <name>vikey</name>
      <language>vi</language>
      <license>GPL-3.0</license>
      <author>Tony Dinh</author>
      <icon>vikey</icon>
      <layout>default</layout>
      <longname>SmartKey</longname>
      <description>SmartKey - Gõ tiếng Việt, tự chuyển Anh/Việt</description>
      <rank>99</rank>
      <symbol>V</symbol>
      <setup>@CMAKE_INSTALL_FULL_BINDIR@/vikey-settings</setup>
    </engine>
  </engines>
</component>
